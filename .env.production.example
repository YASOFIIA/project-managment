# Production Environment Variables (AWS EC2 Deployment)
# Copy to .env and fill in real values. NEVER commit .env!

# Database
POSTGRES_DB=pm_db
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://pm_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/pm_db

# Security
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
LAMBDA_CALLBACK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# AWS (eu-north-1 Stockholm)
AWS_REGION=eu-north-1
STORAGE_BACKEND=s3
S3_BUCKET_NAME=pm-documents
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_ENDPOINT_URL=

# Email (AWS SES SMTP — sandbox mode)
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_FROM=sonya.poczta@gmail.com
SMTP_USERNAME=YOUR_SES_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SES_SMTP_PASSWORD
SMTP_USE_TLS=true

# App
APP_BASE_URL=http://YOUR_EC2_PUBLIC_IP
ENVIRONMENT=production
