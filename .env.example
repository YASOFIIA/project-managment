# Application
PYTHONPATH=src
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL 16 with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pm_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pm_test

# Security & JWT (REQUIRED - NO DEFAULT VALUE, lifetime exactly 1 hour = 60 minutes)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage

# AWS / LocalStack Configuration (for Phase 9+)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=pm-documents

# Lambda Integration & Limits (REQUIRED - NO DEFAULT VALUE, Phase 10+)
LAMBDA_CALLBACK_SECRET=replace-with-internal-callback-secret
PROJECT_SIZE_LIMIT_BYTES=52428800  # 50 MB in bytes

# SMTP & Email Notifications (MailHog for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=pm-service@localhost
# Public URL of the frontend (invitation links open {APP_BASE_URL}/join). Vite dev: http://localhost:5173
APP_BASE_URL=http://localhost
INVITATION_EXPIRE_HOURS=48
